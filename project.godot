; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are meant to be edited.
;
; It won't be regenerated if it exists, so do not touch it.

config_version=5

[application]

config/name="Deluge Chronicles"
config/description="A turn-based card RPG set in flooded Bangkok, October 2025 onward. Working title."
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")

[autoload]

GameData="*res://scripts/autoload/game_data.gd"
RunState="*res://scripts/autoload/run_state.gd"

[display]

window/size/viewport_width=480
window/size/viewport_height=460
window/size/window_width_override=960
window/size/window_height_override=920
window/stretch/mode="viewport"
window/stretch/aspect="keep"
window/stretch/scale_mode="fractional"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
